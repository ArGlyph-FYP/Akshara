# Copy to .env.local. These defaults run everything against the local Firebase emulators.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-akshara.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-akshara
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-akshara.appspot.com
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app
NEXT_PUBLIC_USE_EMULATORS=true
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# Against the real project instead: remove the emulator lines above, set the real web config,
# and either `gcloud auth application-default login` or paste a service account JSON here (one line):
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
