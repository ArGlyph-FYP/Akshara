{
  "name": "akshara-registry",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "emulators": "firebase emulators:start --project demo-akshara",
    "seed:demo": "tsx --env-file-if-exists=.env.local scripts/seed-demo.ts",
    "set-admin": "tsx --env-file-if-exists=.env.local scripts/set-admin.ts",
    "export": "tsx --env-file-if-exists=.env.local scripts/export-dataset.ts",
    "set-admin:prod": "tsx --env-file=.env.prod scripts/set-admin.ts",
    "export:prod": "tsx --env-file=.env.prod scripts/export-dataset.ts",
    "env:emulators": "cp .env.emulators .env.local && echo 'Local app now uses the EMULATORS (restart npm run dev)'",
    "env:prod": "cp .env.prod .env.local && echo 'Local app now uses the REAL akshara-fyp project (restart npm run dev)'",
    "cors:prod": "tsx --env-file=.env.prod scripts/set-cors.ts",
    "delete-samples:prod": "tsx --env-file=.env.prod scripts/delete-samples.ts",
    "test-data:prod": "tsx --env-file=.env.prod scripts/test-data.ts"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^1.58.0",
    "nanoid": "^5.1.16",
    "next": "15.5.28",
    "pdfjs-dist": "^6.3.289",
    "radix-ui": "^1.8.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-zoom-pan-pinch": "^4.2.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/postcss": "^4",
    "@types/archiver": "^8.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "firebase-tools": "^15.34.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "jwks-rsa": {
      "jose": "5.10.0"
    }
  }
}
